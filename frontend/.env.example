# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/amyrose_db?schema=public"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional: OAuth providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── MercadoPago ─────────────────────────────────────────────────────────────
# Server-only token (never expose to browser)
MERCADOPAGO_ACCESS_TOKEN=""
# For verifying IPN webhook signatures
MERCADOPAGO_WEBHOOK_SECRET=""
# Browser-safe public key (for Payment Brick)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# ─── Backend API ─────────────────────────────────────────────────────────────
# NestJS backend base URL (server-side only)
BACKEND_API_URL="http://localhost:3001/api/v1"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier includes 25 GB storage / 25 GB bandwidth
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
